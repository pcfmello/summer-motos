{
  "name": "summer-motos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --banco=teste",
    "db:status": "tsx scripts/db-status.ts",
    "db:status:test": "tsx scripts/db-status.ts --banco=teste"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "better-auth": "1.7.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
