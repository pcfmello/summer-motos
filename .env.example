# =============================================================================
# SUMMER: variáveis de ambiente
# =============================================================================
# Local:   cp .env.example .env   (o .env nunca é commitado; está no .gitignore)
# Coolify: cadastre as mesmas variáveis em cada app (app e worker) de cada
#          ambiente, com valores próprios. Ver docs/deploy.md, seção 4.
#
# Regras:
# - Os valores abaixo servem só para desenvolvimento local. Nenhum é segredo real.
# - Homologação e produção NUNCA compartilham valores (banco, bucket, chaves).
# - Nada sensível com o prefixo NEXT_PUBLIC_: ele vai para o navegador.
# - Tokens do Focus NFe, credenciais do Mercado Livre e chaves de API dos canais
#   NÃO ficam aqui: são por empresa, cifrados no banco (modelo de dados 1.7).
# - Toda variável nova entra neste arquivo e na tabela de docs/deploy.md.
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Ambiente lógico: local | homologacao | producao.
# Bloqueia o seed fora de local/homologacao e aparece no healthcheck e nos logs.
SUMMER_AMBIENTE=local

# Porta do servidor Next (no container, o padrão já é 3000).
PORT=3000


# -----------------------------------------------------------------------------
# Banco (PostgreSQL 17)
# -----------------------------------------------------------------------------

# Usadas só pelo docker-compose.yml para criar o Postgres local.
POSTGRES_USER=summer
POSTGRES_PASSWORD=summer_dev
POSTGRES_DB=summer
POSTGRES_TEST_DB=summer_test
POSTGRES_PORT=5432

# Conexão do app e do worker (Pool único, src/server/db/index.ts).
# Em homologação/produção é o usuário restrito "summer_app", sem DDL e sem
# TRUNCATE (docs/deploy.md, seção 9).
DATABASE_URL=postgres://summer:summer_dev@127.0.0.1:5432/summer

# Conexão usada SÓ para aplicar migrações (scripts/migrate.ts), com o usuário
# dono do schema ("summer_owner"). Vazia = usa DATABASE_URL (normal no local).
DATABASE_URL_MIGRACAO=

# Banco exclusivo dos testes de integração (D011). Os testes dão TRUNCATE nele:
# nunca aponte para o banco de desenvolvimento.
DATABASE_URL_TEST=postgres://summer:summer_dev@127.0.0.1:5432/summer_test

# Tamanho máximo do Pool por processo (opcional; padrão definido no código).
# Some app + worker por ambiente e mantenha abaixo do max_connections do Postgres.
DATABASE_POOL_MAX=10


# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------

# Segredo de assinatura das sessões: no mínimo 32 caracteres aleatórios.
# Gere um por ambiente:  openssl rand -base64 32
# Trocar o segredo derruba todas as sessões abertas.
BETTER_AUTH_SECRET=troque-por-um-segredo-local-de-32-caracteres-ou-mais

# URL pública do app, sem barra no final (homologação/produção: o domínio HTTPS).
BETTER_AUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Storage S3 (MinIO no local, Cloudflare R2 em homologação/produção)
# -----------------------------------------------------------------------------
# O banco guarda só a chave do arquivo. Cada ambiente tem o próprio bucket.

# Local: o MinIO do docker-compose.
# R2:    https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:9000

# MinIO aceita qualquer região (use us-east-1). R2: auto.
S3_REGION=us-east-1

# Bucket do ambiente (criado pelo serviço minio-init no local).
S3_BUCKET=summer-local

# Chave do app. No local, o minio-init cria este usuário no MinIO.
# No R2: um token "Object Read & Write" restrito ao bucket do ambiente.
S3_ACCESS_KEY_ID=summer-app
S3_SECRET_ACCESS_KEY=summer_dev_app

# true para o MinIO (http://host:9000/bucket/chave). R2 funciona com os dois;
# deixe false em homologação/produção.
S3_FORCE_PATH_STYLE=true

# Usadas só pelo docker-compose.yml (MinIO local). A senha tem no mínimo 8 caracteres.
MINIO_ROOT_USER=summer
MINIO_ROOT_PASSWORD=summer_dev_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001


# -----------------------------------------------------------------------------
# Cifragem de segredos no banco (modelo de dados 1.7)
# -----------------------------------------------------------------------------
# AES-256-GCM. Lista "versão:chave", separada por vírgula; cada chave tem
# 32 bytes em base64. A versão vai gravada no primeiro byte de cada valor
# cifrado, o que permite rotacionar: acrescente v2, recifre aos poucos e só
# então remova v1.
# Gere uma chave:  openssl rand -base64 32
# PERDER ESTA CHAVE = perder os tokens do Focus, do Mercado Livre e das
# senhas de certificado. Guarde-a num cofre de senhas, fora do servidor.
# A chave abaixo é só de desenvolvimento (32 bytes zerados): nunca use fora do local.
CHAVES_CIFRAGEM=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=


# -----------------------------------------------------------------------------
# Seed de demonstração (pnpm db:seed; só local e homologação)
# -----------------------------------------------------------------------------
# Senhas dos usuários de demonstração (seção 8 da especificação).
# Em homologação, use senhas fortes: o ambiente fica na internet.
SEED_SENHA_ADMIN=admin-demo-local
SEED_SENHA_DONO=dono-demo-local
SEED_SENHA_BALCAO=balcao-demo-local
SEED_SENHA_ESTOQUE=estoque-demo-local
SEED_SENHA_MECANICO=mecanico-demo-local


# -----------------------------------------------------------------------------
# Worker (pg-boss, src/worker/index.ts)
# -----------------------------------------------------------------------------

# Schema do Postgres onde o pg-boss guarda a fila.
PGBOSS_SCHEMA=pgboss

# Quantos jobs o worker processa ao mesmo tempo.
WORKER_CONCORRENCIA=5


# -----------------------------------------------------------------------------
# Deploy (só nos containers do Coolify; ignorado no pnpm dev)
# -----------------------------------------------------------------------------

# true = o container aplica as migrações pendentes antes de iniciar
# (docs/deploy.md, seção 5). Local: rode pnpm db:migrate à mão.
MIGRAR_AO_INICIAR=false

# Opcional: pasta das migrações SQL lida pelo script de migração (D023).
# Vazia = src/server/db/migrations, relativa ao diretório de trabalho.
MIGRACOES_DIR=
